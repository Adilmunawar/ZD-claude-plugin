{
  "extraKnownMarketplaces": {
    "zaraatdost": {
      "source": {
        "source": "git",
        "url": "https://github.com/Adilmunawar/ZD-claude-plugin.git"
      }
    }
  },
  "enabledPlugins": {
    "zaraat-dost@zaraatdost": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/gee.json)",
      "Read(./**/*ee-key*.json)",
      "Read(./**/*service-account*.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Write(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(./.github/workflows/**)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(irm * | iex)"
    ]
  },
  "disableBypassPermissionsMode": "disable"
}
